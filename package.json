{
  "name": "sesha-app",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "Style/login_app"
  ],
  "scripts": {
    "dev": "npm run dev -w login_app",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w login_app",
    "test": "npm run test -w backend && npm run test -w login_app",
    "lint": "npm run lint -w backend && npm run lint -w login_app",
    "seed": "npm run seed -w backend",
    "migrate": "npm run migrate -w backend"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.21.2",
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.8"
  },
  "devDependencies": {
    "minimatch": "11.0.8"
  }
}
