NODE_ENV=development
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/sesha_academico
JWT_SECRET=
APP_ORIGIN=http://localhost:5173
# Solo para nuevas cuentas en una semilla autorizada. Definir de forma privada.
SEED_ADMIN_PASSWORD=
SEED_CARLOS_PASSWORD=
SEED_LAURA_PASSWORD=
# Solo para carga académica autorizada con --apply.
DEMO_EMPLOYEES_PASSWORD=
# Solo para una base de desarrollo desechable; producción siempre lo ignora.
ALLOW_SELF_REGISTRATION=false
